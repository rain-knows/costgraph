DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-pro
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_THINKING=disabled
DEEPSEEK_TIMEOUT_SECONDS=30
APP_ENV=demo
APP_VERSION=dev
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
COST_DATABASE_URL=postgresql+psycopg://user:password@host:5432/costgraph
COST_DATABASE_POOL_SIZE=5
COST_DATABASE_MAX_OVERFLOW=10
AGENT_MAX_MODEL_CALLS=3
AGENT_MAX_TOOL_CALLS=12
AGENT_TOOL_TIMEOUT_SECONDS=15
AGENT_RUN_TIMEOUT_SECONDS=180
AGENT_RUN_LEASE_SECONDS=90
AGENT_RUN_HEARTBEAT_SECONDS=15
AGENT_RUN_MAX_ATTEMPTS=3
AGENT_WORKER_CONCURRENCY=1
AGENT_CHECKPOINT_RETENTION_HOURS=24
AGENT_SERVER_ALLOWED_CAPABILITIES=system_help,cost_calculation,report_generation
# OIDC：staging/production 必须配置 issuer、audience、jwks_uri，否则启动校验失败。
# 本地/演示环境需指向真实 OIDC 提供方；测试通过 FastAPI dependency_overrides
# 注入主体，不读取这里的配置。
OIDC_ISSUER=
OIDC_AUDIENCE=
OIDC_JWKS_URI=
OIDC_TENANT_CLAIM=tenant_id
OIDC_ROLES_CLAIM=roles
OIDC_JWKS_CACHE_SECONDS=600
OIDC_LEEWAY_SECONDS=30
AUDIT_TRACE_MODE=metadata
AUDIT_TRACE_RETENTION_DAYS=30
