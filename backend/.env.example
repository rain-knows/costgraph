DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-pro
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_THINKING=disabled
DEEPSEEK_TIMEOUT_SECONDS=30
APP_ENV=demo
APP_VERSION=dev
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
COST_DATABASE_URL=postgresql+psycopg://user:password@host:5432/costgraph
COST_DATABASE_POOL_SIZE=5
COST_DATABASE_MAX_OVERFLOW=10
AGENT_MAX_MODEL_CALLS=3
AGENT_MAX_TOOL_CALLS=12
AGENT_TOOL_TIMEOUT_SECONDS=15
AGENT_RUN_TIMEOUT_SECONDS=180
AGENT_RUN_LEASE_SECONDS=90
AGENT_RUN_HEARTBEAT_SECONDS=15
AGENT_RUN_MAX_ATTEMPTS=3
AGENT_WORKER_CONCURRENCY=1
AGENT_CHECKPOINT_RETENTION_HOURS=24
AGENT_PRINCIPAL_ID=local-costgraph-user
AGENT_TENANT_ID=local-costgraph-tenant
AGENT_PRINCIPAL_ROLES=cost_analyst
AGENT_SERVER_ALLOWED_CAPABILITIES=system_help,cost_calculation
AGENT_ALLOWED_PRODUCT_IDS=
AGENT_ALLOWED_PERIOD_START=
AGENT_ALLOWED_PERIOD_END=
AUDIT_TRACE_MODE=metadata
AUDIT_TRACE_RETENTION_DAYS=30
