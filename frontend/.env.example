# OIDC 授权码 + PKCE 登录配置。访问令牌只在内存中保存，刷新后需要重新登录。
VITE_OIDC_ISSUER=https://id.example.com/realms/costgraph
VITE_OIDC_CLIENT_ID=costgraph-workbench
VITE_OIDC_REDIRECT_URI=http://127.0.0.1:5173/auth/callback
VITE_OIDC_SCOPE=openid profile email

# 仅本地 demo 开发启动使用，与 backend 的 LOCAL_DEMO_AUTH_ENABLED=true 配对。
# staging/production 构建必须保持 false 或不设置，并使用 OIDC。
VITE_LOCAL_DEMO_AUTH=false

# 工作区默认查询期间（YYYY-MM），未在 URL 指定时使用。
VITE_DEFAULT_PERIOD=2026-06
